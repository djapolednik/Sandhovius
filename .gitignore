.env

# Go build output — the agent is built via its Dockerfile for actual
# deployment, a local `go build` binary here is a leftover dev artifact.
# The binary, not the agent/main/ source folder (go build ./main writes
# into that folder when it already exists).
agent/main/main
agent/main/main.exe
agent/main.exe
agent/bin/

# Impeccable: machine-local settings and the detector hook's cache.
.impeccable/config.local.json
.impeccable/hook.cache.json

# Ontwerp-inspiratie (beelden van anderen): alleen lokaal, niet in de repo.
frontend/dashboard-inspo/

# Integratietests: gedownloade PocketBase-binary
backend/tests/.cache/
